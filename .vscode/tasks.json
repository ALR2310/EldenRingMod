{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Cargo: Build AutoRegen (Release)",
            "detail": "Builds AutoRegen (release), then copies AutoRegen.dll + AutoRegen.ini into build/",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\scripts\\build-mod.ps1",
                "-Mod", "AutoRegen"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$rustc"
        },
